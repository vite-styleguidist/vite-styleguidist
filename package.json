{
  "name": "vite-styleguidist",
  "description": "Isolated React component development environment with a living style guide, powered by Vite. A maintained fork of React Styleguidist.",
  "version": "0.0.0-development",
  "homepage": "https://vite-styleguidist.github.io/vite-styleguidist/",
  "author": {
    "name": "Mihail-Gabriel Alexe"
  },
  "contributors": [
    {
      "name": "Artem Sapegin",
      "url": "https://sapegin.me/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-styleguidist/vite-styleguidist.git"
  },
  "bugs": {
    "url": "https://github.com/vite-styleguidist/vite-styleguidist/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/scripts/index.js",
  "types": "./lib/scripts/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/scripts/index.d.ts",
      "default": "./lib/scripts/index.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "styleguidist": "lib/bin/styleguidist.js"
  },
  "files": [
    "lib",
    "templates"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@tippyjs/react": "^4.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "clipboard-copy": "^4.0.1",
    "clsx": "^2.1.1",
    "doctrine": "^3.0.0",
    "estree-walker": "^3.0.3",
    "fastest-levenshtein": "^1.0.16",
    "github-slugger": "^2.0.0",
    "glob": "^13.0.6",
    "glogg": "^2.2.0",
    "hash-sum": "^2.0.0",
    "jss": "^10.10.0",
    "jss-plugin-camel-case": "^10.10.0",
    "jss-plugin-compose": "^10.10.0",
    "jss-plugin-default-unit": "^10.10.0",
    "jss-plugin-global": "^10.10.0",
    "jss-plugin-isolate": "^10.10.0",
    "jss-plugin-nested": "^10.10.0",
    "kleur": "^4.1.5",
    "listify": "^1.0.3",
    "lodash": "^4.18.1",
    "lowercase-keys": "^4.0.1",
    "markdown-to-jsx": "^9.10.2",
    "mri": "^1.2.0",
    "open": "^11.0.2",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "q-i": "^2.0.1",
    "react-docgen": "^8.0.3",
    "react-group": "^4.0.0",
    "react-icons": "^5.7.0",
    "react-simple-code-editor": "^0.14.1",
    "remark": "^15.0.1",
    "sirv": "^3.0.2",
    "strip-html-comments": "^1.0.0",
    "sucrase": "^3.35.1",
    "type-detect": "^4.1.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "react": ">=18.0",
    "react-dom": ">=18.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@styled-system/theme-get": "^5.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/doctrine": "^0.0.9",
    "@types/estree": "^1.0.9",
    "@types/hash-sum": "^1.0.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/prismjs": "^1.26.6",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/styled-system__theme-get": "^5.0.4",
    "@types/type-detect": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "deepfreeze": "^2.0.0",
    "dog-names": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "memfs": "^4.68.2",
    "polished": "^4.3.1",
    "preact": "^10.29.8",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "pretest": "npm run lint && npm run typecheck",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node lib/bin/styleguidist.js server --config examples/basic/styleguide.config.js",
    "start:customised": "node lib/bin/styleguidist.js server --config examples/customised/styleguide.config.js",
    "start:sections": "node lib/bin/styleguidist.js server --config examples/sections/styleguide.config.js",
    "start:ui": "node lib/bin/styleguidist.js server",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "compile": "node scripts/clean-lib.js && tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "compile:watch": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "npm run compile",
    "build:basic": "node lib/bin/styleguidist.js build --config examples/basic/styleguide.config.js",
    "build:customised": "node lib/bin/styleguidist.js build --config examples/customised/styleguide.config.js",
    "build:sections": "node lib/bin/styleguidist.js build --config examples/sections/styleguide.config.js",
    "test:browser:pre": "npm i --no-save puppeteer@25.10.0",
    "test:browser:basic": "node test/browser.js examples/basic/styleguide",
    "test:browser:customised": "node test/browser.js examples/customised/styleguide",
    "test:browser:sections": "node test/browser.js examples/sections/styleguide",
    "format": "prettier --log-level warn --write \"**/*.{js,md}\"",
    "test:cypress:pre": "npm i --no-save cypress@15.21.1 wait-on@9.1.0",
    "test:cypress:open": "cypress open",
    "test:cypress:run": "cypress run",
    "test:cypress:startServer": "node test/run.server.js",
    "test:cypress:startServer:post": "wait-on http://localhost:8082",
    "build:themed": "node lib/bin/styleguidist.js build --config examples/themed/styleguide.config.js",
    "test:browser:themed": "node test/browser.js examples/themed/styleguide",
    "build:express": "node lib/bin/styleguidist.js build --config examples/express/styleguide.config.js",
    "test:browser:express": "node test/browser.js examples/express/styleguide",
    "build:preact": "node lib/bin/styleguidist.js build --config examples/preact/styleguide.config.js",
    "test:browser:preact": "node test/browser.js examples/preact/styleguide",
    "build:styled-components": "node lib/bin/styleguidist.js build --config examples/styled-components/styleguide.config.js",
    "test:browser:styled-components": "node test/browser.js examples/styled-components/styleguide",
    "build:vite": "node lib/bin/styleguidist.js build --config examples/vite/styleguide.config.js",
    "test:browser:vite": "node test/browser.js examples/vite/styleguide",
    "hooks:install": "husky"
  },
  "keywords": [
    "react",
    "jsx",
    "styleguide",
    "style guide",
    "documentation",
    "docs",
    "generator",
    "component",
    "components",
    "vite",
    "styleguidist",
    "react-styleguidist"
  ],
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,mjs,cjs,ts,tsx,md,css,json}": [
      "prettier --write"
    ]
  }
}
