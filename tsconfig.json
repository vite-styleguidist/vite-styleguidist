{
  // Type-checking config (no emit). The publishable build uses tsconfig.build.json.
  //
  // Why `module: ESNext` + `moduleResolution: bundler` instead of NodeNext:
  // - the client code (src/client) is consumed by Vite, which resolves extensionless
  //   `rsg-components/*` alias imports and directory indexes; NodeNext would reject them;
  // - the Node side (src/scripts, src/loaders, src/bin) still runs as native ESM, so every
  //   relative import in src carries an explicit `.js` extension (enforced by ESLint).
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "rsg-components/*": ["src/client/rsg-components/*"]
    },
    "types": ["vite/client", "node", "vitest/globals"]
  },
  "include": ["src", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "lib"]
}
